# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# runtime admin overrides (MAIL_ENABLED toggle, etc.)
/data/runtime-settings.json

# migration dumps (keep templates)
data/migration/*.sql
data/migration/unit-mapping.csv
data/migration/model-mapping.csv
data/migration/.server*.env
!data/migration/*.example
!data/migration/.gitkeep

# uploads
/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
