# Database lokal ARKA PCR (Prisma) — WAJIB mysql:// (bukan prisma:// Accelerate)
DATABASE_URL="mysql://root:@localhost:3306/arka_pcr_new"

# Database staging untuk import SQL legacy (opsional)
LEGACY_DATABASE_URL="mysql://root:@localhost:3306/arka_pcr_legacy"

# Path file migrasi (taruh SQL dump & CSV di folder ini)
MIGRATION_DATA_DIR="./data/migration"
LEGACY_SQL_PATH="./data/migration/legacy.sql"
UNIT_MAPPING_CSV="./data/migration/unit-mapping.csv"
MODEL_MAPPING_CSV="./data/migration/model-mapping.csv"

# Fleet API (ark-fleet) — set enabled=false saat belum bisa diakses
FLEET_API_URL="http://192.168.32.15/ark-fleet/api"
PROJECTS_API_URL="http://192.168.32.15/ark-fleet/api/projects"
ARK_FLEET_UNITS_URL="http://192.168.32.15/ark-fleet/api/equipments"
FLEET_API_ENABLED="false"
FLEET_API_TIMEOUT_MS="15000"

# SAP Business One Service Layer — server-side only (never NEXT_PUBLIC_*)
# Session: lib/sap-b1/cookie-jar.ts + ensureSession(); smoke test: npm run sap:ping
# Docs: docs/sap-b1-session-management.md
# BASE_URL: host + port Service Layer + /b1s/v1 atau /b1s/v2 (sesuaikan instalasi B1)
SAP_B1_BASE_URL="https://arkasrv2:50000/b1s/v1"
SAP_B1_COMPANY_DB="SBO_ARKA_NEW"
SAP_B1_USER="manager"
SAP_B1_PASSWORD=""
SAP_B1_ENABLED="false"
SAP_B1_ITEM_GROUP_CODES="114"
SAP_B1_TLS_REJECT_UNAUTHORIZED="false"
SAP_B1_TIMEOUT_MS="15000"

# NextAuth — dev lokal tanpa subpath. Production Docker: http://host/arka-pcr
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Opsional subpath lokal (uji build production): NEXT_PUBLIC_BASE_PATH=/arka-pcr

# ACL / RBAC (permission middleware, API, CASL AclGuard). false = bypass sementara.
ACL_ENABLED="true"
NEXT_PUBLIC_ACL_ENABLED="true"

# Upload
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# Email notifications (SMTP / Nodemailer)
# Default on/off. Admin dapat override runtime di /admin/email-notifications (tanpa restart).
MAIL_ENABLED="true"
MAIL_FROM="ARKA PCR <>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Activity log (Spatie-style audit trail). false = skip writes.
ACTIVITYLOG_ENABLED="true"
ACTIVITYLOG_CLEAN_AFTER_DAYS="365"

# Vuexy legacy JWT (demo pages — bisa diabaikan untuk modul ARKA)
NEXT_PUBLIC_JWT_EXPIRATION=5m
NEXT_PUBLIC_JWT_SECRET=change-me
NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET=change-me
