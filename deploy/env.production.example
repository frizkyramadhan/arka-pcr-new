# =============================================================================
# ARKA PCR — production env untuk Docker Compose (/home/skyone/stack)
# =============================================================================
# Di server, salin file ini menjadi:
#   /home/skyone/stack/apps/app81/arka-pcr/.env
#
# JANGAN commit file .env berisi secret.
# Generate AUTH_SECRET: openssl rand -base64 32
# =============================================================================

NODE_ENV=production

# URL publik yang dipakai browser (harus cocok dengan Nginx + base path)
# Subpath di port 80 bersama app lain:
#   AUTH_URL="http://192.168.32.146/arka-pcr"
# Root domain khusus PCR:
#   AUTH_URL="http://pcr.example.local"
AUTH_URL="http://192.168.32.146/arka-pcr"
AUTH_SECRET="REPLACE_WITH_openssl_rand_base64_32"

# Cookie Secure: false jika akses lewat HTTP (tanpa TLS). true jika HTTPS.
JWT_COOKIE_SECURE="false"

# -----------------------------------------------------------------------------
# Database — WAJIB hostname service Docker "mysql", BUKAN localhost / 127.0.0.1
# -----------------------------------------------------------------------------
DATABASE_URL="mysql://pcr_user:CHANGE_ME_STRONG_PASSWORD@mysql:3306/arka_pcr_new"

# -----------------------------------------------------------------------------
# Fleet API (reachable dari container arka-pcr)
# -----------------------------------------------------------------------------
FLEET_API_URL="http://192.168.32.15/ark-fleet/api"
PROJECTS_API_URL="http://192.168.32.15/ark-fleet/api/projects"
ARK_FLEET_UNITS_URL="http://192.168.32.15/ark-fleet/api/equipments"
FLEET_API_ENABLED="true"
FLEET_API_TIMEOUT_MS="15000"

# -----------------------------------------------------------------------------
# ACL / RBAC
# -----------------------------------------------------------------------------
ACL_ENABLED="true"
NEXT_PUBLIC_ACL_ENABLED="true"

# -----------------------------------------------------------------------------
# Uploads (path di dalam container; di-bind ke ./apps/app81/arka-pcr/uploads)
# -----------------------------------------------------------------------------
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_SIZE_MB="10"

# -----------------------------------------------------------------------------
# Email notifications (SMTP / Nodemailer)
# -----------------------------------------------------------------------------
MAIL_ENABLED="true"
MAIL_FROM="ARKA PCR <noreply@arka.co.id>"
SMTP_HOST=mail.arka.co.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Activity log (Spatie-style audit trail)
# -----------------------------------------------------------------------------
ACTIVITYLOG_ENABLED="true"
ACTIVITYLOG_CLEAN_AFTER_DAYS="365"

# -----------------------------------------------------------------------------
# SAP B1 Service Layer — container harus resolve host (lihat extra_hosts arkasrv2)
# -----------------------------------------------------------------------------
SAP_B1_ENABLED="true"
SAP_B1_BASE_URL="https://arkasrv2:50000/b1s/v1"
SAP_B1_COMPANY_DB="SBO_AAP_NEW"
SAP_B1_USER="manager"
SAP_B1_PASSWORD=""
SAP_B1_ITEM_GROUP_CODES="114"
SAP_B1_TLS_REJECT_UNAUTHORIZED="false"
SAP_B1_TIMEOUT_MS="15000"

# -----------------------------------------------------------------------------
# Migrasi data legacy (hanya saat cutover — bukan runtime app sehari-hari)
# -----------------------------------------------------------------------------
# LEGACY_DATABASE_URL="mysql://pcr_user:CHANGE_ME_STRONG_PASSWORD@mysql:3306/arka_pcr_legacy"
# MIGRATION_DATA_DIR="./data/migration"
# LEGACY_SQL_PATH="./data/migration/legacy.sql"
# UNIT_MAPPING_CSV="./data/migration/unit-mapping.csv"
# MODEL_MAPPING_CSV="./data/migration/model-mapping.csv"

# Entrypoint: jalankan prisma migrate deploy saat container start
RUN_MIGRATE_ON_START="true"

PORT=3000
HOSTNAME=0.0.0.0
