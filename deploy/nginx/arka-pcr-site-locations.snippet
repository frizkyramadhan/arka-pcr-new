# =============================================================================
# Salin isi blok di bawah ke dalam server { } HTTP di site.conf (port 80).
# Aplikasi Next.js harus di-build dengan NEXT_PUBLIC_BASE_PATH=/arka-pcr
# dan AUTH_URL=http://<host>/arka-pcr
# (client_max_body_size di server block site.conf sudah 128m — jangan duplikasi)
#
# Setelah recreate container arka-pcr, restart nginx agar IP upstream ter-resolve ulang:
#   docker compose restart nginx
# Upstream keepalive + Connection "upgrade" pada request biasa menyebabkan 502 —
# pakai Connection "" (lihat di bawah).
# =============================================================================

location = /arka-pcr {
    return 301 /arka-pcr/;
}

location /arka-pcr/ {
    proxy_pass http://arka_pcr_upstream;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    # Upstream uses keepalive — empty Connection for normal HTTP (not always "upgrade").
    proxy_set_header Connection "";

    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;

    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 8 256k;
}
