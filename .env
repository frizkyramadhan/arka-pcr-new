# App URL (server + client)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Laragon lokal:
DATABASE_URL="mysql://root:@localhost:3306/arka_pcr_new"
# Docker (service name = mysql, bukan localhost). Password dengan @ → encode %40
# DATABASE_URL="mysql://appuser:apppass%40123@mysql:3306/arka_mms"

# -----------------------------------------------------------------------------
# Auth — JWT & cookie (middleware + API)
# -----------------------------------------------------------------------------
#
# JWT_SECRET (server-only, TIDAK ada prefix NEXT_PUBLIC)
#   - Dipakai di: sign/verify token (login, me, API), middleware Edge, permissions-server.
#   - Tidak pernah dikirim ke browser -> aman sebagai rahasia utama.
#   - Wajib di production; jangan commit ke repo.
#
# NEXT_PUBLIC_JWT_SECRET (terbuka ke client -> ikut dibundle JS)
#   - Siapa pun bisa baca di DevTools / bundle.
#   - Di kode hanya dipakai sebagai FALLBACK jika JWT_SECRET kosong + dipakai fake-db demo.
#   - Jangan isi dengan string yang sama persis JWT_SECRET di production:
#     kalau sama, orang bisa forge token karena secret sudah bocor ke client.
#   - Ideal: hanya JWT_SECRET saja; NEXT_PUBLIC_JWT_* secret bisa dihapus setelah pasti tidak pakai fake-db.
#
# NEXT_PUBLIC_JWT_EXPIRATION / NEXT_PUBLIC_JWT_EXPIRATION_SESSION
#   - Boleh public: hanya durasi (7d, 8h), bukan secret.
#
# NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET
#   - Hanya dipakai src/@fake-db/auth/jwt.js (demo). Bukan alur login Prisma yang sekarang.
#   - Bisa dikosongkan jika tidak pakai fake-db auth.
#
# JWT_COOKIE_SECURE
#   - Production default cookie accessToken pakai Secure (HTTPS saja).
#   - Docker/HTTP: set JWT_COOKIE_SECURE=false agar cookie terkirim (hindari redirect loop).
# JWT_COOKIE_MAX_AGE_DAYS - Max-Age cookie saat Remember Me (default 7).
# -----------------------------------------------------------------------------

JWT_SECRET="a29603ef4624e76deffad01f1fc909af1ce3df68589ad20acbc44265f3555b2b"

# Durasi token (bukan secret - aman di NEXT_PUBLIC)
NEXT_PUBLIC_JWT_EXPIRATION="7d"
NEXT_PUBLIC_JWT_EXPIRATION_SESSION="8h"

# Optional cookie
# JWT_COOKIE_MAX_AGE_DAYS=7
JWT_COOKIE_SECURE=false

# Legacy / demo only - sengaja beda dari JWT_SECRET (boleh dibaca client)
# NEXT_PUBLIC_JWT_SECRET="735f38ed81484638b0382db68cecb5e25960e2f2e95dc0274ee96a73ff3c7762"
# NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET="f50cdb51f7dd77335da20f10fd3c97b6d0dc7083e94d0fe3801246bde3e4bb93"

