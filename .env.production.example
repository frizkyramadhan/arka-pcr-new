# Production environment template for ARKA PCR
# Copy to .env.production.local on the server (do NOT commit secrets)

NODE_ENV=production

# Application URL (used by NextAuth)
AUTH_URL="https://pcr.example.com"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Primary database
DATABASE_URL="mysql://pcr_user:STRONG_PASSWORD@127.0.0.1:3306/arka_pcr_new"

# Fleet API — enable when server can reach ark-fleet
FLEET_API_URL="http://192.168.32.15/ark-fleet/api"
FLEET_API_ENABLED="true"
FLEET_API_TIMEOUT_MS="15000"

# File uploads (WO reports PDF)
UPLOAD_DIR="/var/www/arka-pcr/uploads"
MAX_UPLOAD_SIZE_MB="10"

# Optional: legacy migration (usually not needed on production runtime)
# LEGACY_DATABASE_URL=
# MIGRATION_DATA_DIR=
# LEGACY_SQL_PATH=

# Next.js
# PORT=3000
