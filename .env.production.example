# Production environment template for ARKA PCR (Docker Compose on Debian)
# On server: copy to /home/skyone/stack/apps/app81/arka-pcr/.env
# Prefer deploy/env.production.example (more complete). Do NOT commit secrets.

NODE_ENV=production

AUTH_URL="http://192.168.32.146/arka-pcr"
# NextAuth API mount — MUST end with /api/auth (not only /arka-pcr) or client URLs double-prefix
NEXTAUTH_URL="http://192.168.32.146/arka-pcr/api/auth"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_COOKIE_SECURE="false"

# WAJIB: hostname service Docker "mysql" — bukan 127.0.0.1 / localhost
DATABASE_URL="mysql://pcr_user:STRONG_PASSWORD@mysql:3306/arka_pcr_new"

FLEET_API_URL="http://192.168.32.15/ark-fleet/api"
PROJECTS_API_URL="http://192.168.32.15/ark-fleet/api/projects"
ARK_FLEET_UNITS_URL="http://192.168.32.15/ark-fleet/api/equipments"
FLEET_API_ENABLED="true"
FLEET_API_TIMEOUT_MS="15000"

ACL_ENABLED="true"
NEXT_PUBLIC_ACL_ENABLED="true"

UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_SIZE_MB="10"

SAP_B1_ENABLED="false"

# Email notifications (SMTP / Nodemailer)
MAIL_ENABLED="true"
MAIL_FROM="ARKA PCR <noreply@arka.co.id>"
SMTP_HOST=mail.arka.co.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Activity log (Spatie-style). false = skip writes.
ACTIVITYLOG_ENABLED="true"
ACTIVITYLOG_CLEAN_AFTER_DAYS="365"

RUN_MIGRATE_ON_START="true"
PORT=3000
HOSTNAME=0.0.0.0
